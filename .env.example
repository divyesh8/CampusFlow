# Non-secret production examples. Set real values in Render Environment settings.
NODE_ENV=production
# Documentation/local container testing only. Render injects its own PORT.
PORT=10000
FRONTEND_ORIGIN=https://YOUR-RENDER-DOMAIN.onrender.com
SESSION_TTL_MINUTES=10
MAX_ACTIVE_SESSIONS=2
NEXT_PUBLIC_APP_NAME=CampusFlow

# FRONTEND_ORIGIN: exact public HTTPS origin, no trailing slash or /login path.
# Local next dev: NODE_ENV=development, PORT=3000,
# FRONTEND_ORIGIN=http://localhost:3000
# One service only. Memory sessions disappear on restart/sleep.
# No SRM credentials, Supabase keys, session encryption key, or database needed.
