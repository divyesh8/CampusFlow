# Local development: open this exact origin in your browser.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
SESSION_TTL_MINUTES=15

# Railway production (runtime variables, not NEXT_PUBLIC_ variables):
# NODE_ENV=production
# FRONTEND_ORIGIN=https://<your-actual-campusflow-domain>
# SESSION_TTL_MINUTES=15
# Railway supplies PORT. The Docker command binds 0.0.0.0 on that port.
# Keep one replica: browser sessions live in this process and expire on restart.
# FRONTEND_ORIGIN must be one HTTPS origin, with no path/query/credentials.
# A root trailing slash is accepted. The UI and API must share this origin.
# No SRM credentials, Supabase keys, session encryption keys, or database needed.
